# Provider: auto | local | mock | custom | jev
# auto = local heuristic, no agent required. Uses JEV + gateway only if both are set.
JEV_PROVIDER=auto

# JEV decision API (required for provider=jev). Judge only, never user text.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=jev-latest

# Gateway OpenAI-compatible (classic). If incomplete, the catalog resolves it.
# Examples: https://openrouter.ai/api/v1  https://api.openai.com/v1
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=
GATEWAY_MODELS=

# Multi-LLM catalog. Keys stay in the environment, never in HTTP/MCP bodies.
JEV_MODELS_FILE=
JEV_LLM_DEFAULT=openrouter:anthropic/claude-sonnet-4
JEV_LLM_STRATEGY=named
# JEV_LLM_OPENROUTER_BASE_URL=
# JEV_LLM_OPENROUTER_API_KEY=
# JEV_LLM_OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o-mini

# Provider keys (first match wins per preset)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Router
JEV_MODEL_MAX_ALTERNATIVES=3
JEV_MODEL_MAX_CANDIDATES=50

# Security
JEV_REDACT_SECRETS=true
JEV_MODEL_AUTH_TOKEN=

# Server
JEV_MODEL_HOST=127.0.0.1
JEV_MODEL_PORT=8080
JEV_MODEL_TIMEOUT=30.0
